#!/bin/sh
#
# charon-mount: mount an rclone remote via FUSE and manage its systemd user unit
#

# The template blocks at the end of this file are DATA read back out of it,
# not code. They must still parse as shell (dash -n reads past `exit 0`), but
# a static analyser reads `[Unit]` as a broken test expression. dash -n is
# the authoritative parse check here, so silencing that confusion costs us
# nothing real.
# shellcheck disable=SC1035,SC1072,SC1073,SC1020
: "${LOG_LEVEL:=3}"    # 1=ERROR; 2=WARN; 3=INFO; 4=TRACE (environment wins)
# logger + CHARON_REMOTE + CHARON_MOUNT, shared with charon-sync (sibling in
# libexec). Reached via the `charon` dispatcher, or run directly.
_self=$(readlink -f "$0" 2>/dev/null || echo "$0")
# Where the sibling impls and common.sh live. Normally alongside this file;
# CHARON_LIBEXEC overrides it so a unit test can SOURCE this file, where $0 is
# the test's shell rather than the script and self-location cannot work.
CHARON_LIBEXEC=${CHARON_LIBEXEC:-$(dirname "$_self")}
. "$CHARON_LIBEXEC/common.sh" 2>/dev/null || {
  echo "charon-mount: cannot source common.sh" >&2; exit 1; }

RCLONE_BIN="${RCLONE_BIN:-rclone}"
# Resolve the remote and the mountpoint FROM THE SOURCE, not from CHARON_REMOTE
# directly. Both impls now ask the same resolver (common.sh's source_get), so
# the mount cannot bring up one tree while the sync reconciles another. With no
# sources.d file the implicit 'default' source derives exactly what
# CHARON_REMOTE gave before, so this is a no-op for a single-remote install.
REMOTE_NAME="${REMOTE_NAME:-$(source_get "$CHARON_SOURCE" REMOTE)}"
MOUNTPOINT="${MOUNTPOINT:-$(source_get "$CHARON_SOURCE" MOUNT)}"
# ONE TEMPLATE, INSTANCED PER SOURCE. This replaced a singleton that could only
# ever mount one remote: a second rclone-backed source was accepted by the
# config, handed profiles and sync units, and then silently never mounted. The
# limitation was never rclone's -- rclone holds many remotes in one config,
# namespaces its VFS cache per remote, and runs one process per mount -- it was
# purely this unit being a single file with one source baked into it.
SYSTEMD_TEMPLATE="charon-mount@.service"
# The singleton, swept on install. Named here because a box upgrading across
# this change is still running it, and leaving it would mount the same tree
# twice under two unit names.
LEGACY_UNIT="charon-mount.service"

mount_unit() { printf 'charon-mount@%s.service' "$1"; }

# The instances that are ENABLED, one source name per line.
#
# READ FROM THE ENABLEMENT SYMLINKS, never from `list-unit-files`. A template
# INSTANCE is not a unit file: `list-unit-files 'charon-mount@*.service'`
# reports the TEMPLATE, charon-mount@.service, whose instance part is empty.
# The first version of the orphan check and of uninstall both enumerated that
# way and so found NOTHING on real systemd -- an orphaned instance went
# unreported and uninstall left instances enabled against a template it had
# just deleted. Both passed their test, because the test's systemctl stub
# answered that query the way I assumed rather than the way systemd does.
# Our template's only [Install] target is default.target, so this is the
# complete set.
enabled_instances() {
  _w=$_sd/default.target.wants
  [ -d "$_w" ] || return 0
  for _l in "$_w"/charon-mount@*.service; do
    [ -e "$_l" ] || continue
    _n=$(basename "$_l"); _n=${_n#charon-mount@}; _n=${_n%.service}
    [ -n "$_n" ] && printf '%s\n' "$_n"
  done
  return 0
}

# The rclone-backed sources, one per line. Only these get a mount unit; a
# PROVIDER=none source is someone else's tree and charon must not touch it.
rclone_sources() {
  for _rs in $("$CHARON_LIBEXEC/charon-source" list 2>/dev/null); do
    [ "$("$CHARON_LIBEXEC/charon-source" provider "$_rs")" = rclone ] \
      && printf '%s\n' "$_rs"
  done
  return 0
}

usage() {
  cat <<EOF
usage: $APP_NAME [run|stop|status|install]

  run       Mount the rclone remote (${REMOTE_NAME}:) at ${MOUNTPOINT}
  stop      Unmount ${MOUNTPOINT}
  status    Show whether ${MOUNTPOINT} is mounted
  install   Write charon-mount@.service and enable the instance for this
            source (CHARON_SOURCE=${CHARON_SOURCE}); one instance per source
  uninstall Remove the template and EVERY instance (mountpoints untouched)
  check     Diff the template, and assert every rclone-backed source has an
            enabled, active instance
EOF
}

check_prereqs() {
  if ! command -v "$RCLONE_BIN" >/dev/null 2>&1; then
    log_error "rclone not found in PATH; please install rclone first."
    exit 1
  fi

  if [ ! -d "$MOUNTPOINT" ]; then
    log_info "creating mountpoint directory: $MOUNTPOINT"
    mkdir -p "$MOUNTPOINT" || {
      log_error "failed to create mountpoint: $MOUNTPOINT"
      exit 1
    }
  fi
}

check_if_mounted() {
  if mountpoint -q "$MOUNTPOINT" 2>/dev/null; then
    return 0
  fi
  return 1
}

# The rclone backend type of the configured remote ('drive', 'dropbox', ...),
# or empty if unreadable. Used to apply backend-specific mount flags only where
# they belong.
remote_type() {
  "$RCLONE_BIN" config show "$REMOTE_NAME" 2>/dev/null \
    | sed -n 's/^[[:space:]]*type[[:space:]]*=[[:space:]]*//p' | head -1
}

# Ensure rclone is installed and the '<REMOTE_NAME>:' remote exists.
#
# Many rclone backends (Google Drive, Dropbox, ...) auth over OAuth: the refresh
# token can't be synthesized from prompted values -- it only comes from a real
# browser authorization. But the token is portable and already lives on any
# machine set up before this one, so after the first machine we just pull the
# remote stanza from a configured peer over SSH (rclone.conf is a per-machine
# secret kept out of git anyway). The first machine falls back to the one-time
# interactive `rclone config`. Upstream .deb: distro rclone is often too old for
# a current OAuth flow (e.g. Ubuntu 26.04 ships 1.60.1 (2022), which predates
# Google's 2025-03-31 Photos-scope retirement and cannot complete that flow).
RCLONE_DEB_URL=https://downloads.rclone.org/rclone-current-linux-amd64.deb

ensure_rclone() {
  command -v "$RCLONE_BIN" >/dev/null 2>&1 || {
    log_info "installing rclone from upstream"
    _rd=$(mktemp --suffix=.deb) || exit 1
    if ! curl -fsSL "$RCLONE_DEB_URL" -o "$_rd" \
       || ! sudo apt-get install -y "$_rd"; then
      rm -f "$_rd"
      log_error "rclone install failed"
      exit 1
    fi
    rm -f "$_rd"
  }

  RCLONE_CONF="${RCLONE_CONFIG:-$HOME/.config/rclone/rclone.conf}"

  # already configured -> nothing to do
  if "$RCLONE_BIN" listremotes 2>/dev/null | grep -qx "${REMOTE_NAME}:"; then
    return 0
  fi

  # seamless path: copy the stanza from a peer that already has it
  peer="${CHARON_RCLONE_PEER:-}"
  if [ -z "$peer" ] && [ -t 0 ]; then
    printf "rclone remote '%s:' not found.\n" "$REMOTE_NAME"
    printf "  peer host to copy it from (blank = configure here): "
    read -r peer
  fi

  if [ -n "$peer" ]; then
    log_info "pulling '${REMOTE_NAME}:' from $peer"
    mkdir -p "$(dirname "$RCLONE_CONF")"
    if ssh "$peer" "rclone config show ${REMOTE_NAME}" >>"$RCLONE_CONF" \
       && "$RCLONE_BIN" listremotes 2>/dev/null | grep -qx "${REMOTE_NAME}:"
    then
      log_info "remote '${REMOTE_NAME}:' provisioned from $peer"
      return 0
    fi
    log_error "could not provision '${REMOTE_NAME}:' from $peer"
  fi

  # first machine, or peer pull failed: one-time interactive auth
  if [ -t 0 ]; then
    log_info "run 'rclone config': make a remote named '${REMOTE_NAME}'"
    "$RCLONE_BIN" config
    "$RCLONE_BIN" listremotes 2>/dev/null | grep -qx "${REMOTE_NAME}:" \
      && return 0
  fi

  log_error "remote '${REMOTE_NAME}:' not configured."
  log_error "set CHARON_RCLONE_PEER=<host>, or run: rclone config"
  exit 1
}

do_status() {
  if check_if_mounted; then
    echo "$MOUNTPOINT is mounted (remote: ${REMOTE_NAME}:)"
    return 0
  else
    echo "$MOUNTPOINT is not mounted"
    return 1
  fi
}

do_mount() {
  check_prereqs

  if check_if_mounted; then
    log_info "mountpoint already mounted: $MOUNTPOINT"
    return 0
  fi

  # Core rclone mount flags for "feels like NFS" semantics.
  set -- mount "${REMOTE_NAME}:" "$MOUNTPOINT" \
    --vfs-cache-mode full \
    --vfs-cache-max-size 4G \
    --vfs-cache-max-age 12h \
    --dir-cache-time 1h \
    --poll-interval 30s \
    --buffer-size 64M \
    --transfers 8 \
    --checkers 8 \
    --fast-list

  # --drive-skip-gdocs is Google-Drive-SPECIFIC and load-bearing for the sync,
  # NOT a preference: Drive reports NO byte size for a native gdoc, so
  # rclone can only present one as a 0-byte file. Unison then syncs that stub,
  # sees it diverge from the real local export, and (copyonconflict) lays down a
  # "(conflict_on_DATE)" twin -- 535 junk files in one pass on 2026-06-16.
  # Hiding gdocs removes the stub. Only Drive has this pathology, so gate the
  # flag on the backend type -- other remotes must not get it.
  if [ "$(remote_type)" = drive ]; then
    set -- "$@" --drive-skip-gdocs
  fi

  log_trace "exec $RCLONE_BIN $*"
  # NOTE: exec replaces this shell with rclone; systemd tracks rclone directly
  exec "$RCLONE_BIN" "$@"
}

do_unmount() {
  if ! check_if_mounted; then
    log_info "mountpoint not mounted: $MOUNTPOINT"
    return 0
  fi

  # Prefer fusermount3 if available; fall back to fusermount
  if command -v fusermount3 >/dev/null 2>&1; then
    UMOUNT_BIN=fusermount3
  else
    UMOUNT_BIN=fusermount
  fi

  log_info "unmounting $MOUNTPOINT"
  "$UMOUNT_BIN" -u "$MOUNTPOINT" 2>/dev/null || {
    log_error "failed to unmount $MOUNTPOINT"
    return 1
  }

  if check_if_mounted; then
    log_error "unmount appears to have failed, still mounted: $MOUNTPOINT"
    return 1
  fi

  log_trace "unmount successful: $MOUNTPOINT"
  return 0
}

extract_block() {
  START_MARK="$1"
  END_MARK="$2"

  awk "/^${START_MARK}\$/ {flag=1; next} /^${END_MARK}\$/ {flag=0} flag" \
    "$_self"
}

# The unit this version WOULD write, on stdout. ONE renderer, used by install to
# write it and by check to diff the live one against it. A generated file that
# nothing diffs is invisible drift -- the lesson the prf already taught: three
# hand-patches rode on two boxes for a day because install wrote the prf and
# check never looked at it. The units had exactly the same blind spot.
#
# NOTHING SOURCE-SPECIFIC IS BAKED IN ANY MORE. %i IS the source, and charon
# resolves its remote and mountpoint from sources.d at run time, so ONE
# rendered template serves every instance and editing a source's config no
# longer needs a reinstall to take effect. The single remaining substitution is
# the install-time CHARON_REMOTE, which ONLY the implicit 'default' source
# derives from and which any declared source ignores.
render_unit() {   # <baked-CHARON_REMOTE>
  extract_block "#-----BEGIN-SYSTEMD-UNIT-CHARON-MOUNT-----" \
                "#-----END-SYSTEMD-UNIT-CHARON-MOUNT-----" \
    | sed -e "s|@CHARON_REMOTE@|$1|g"
}

_sd=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
TEMPLATE_FILE="$_sd/$SYSTEMD_TEMPLATE"

# Diff the template against a re-render carrying the CHARON_REMOTE the unit
# ITSELF was installed with, not this shell's. That value is install-time
# policy with no equivalent in charon's config, so re-deriving it would report
# a perfectly correct unit as drift. The same reasoning already applies to the
# sync unit's baked notify path.
check_mount_template() {
  _baked=$(sed -n 's/^Environment=CHARON_REMOTE=//p' "$TEMPLATE_FILE" | head -1)
  _rt=${TMPDIR:-/tmp}/charon-mount-render.$$
  render_unit "${_baked:-$CHARON_REMOTE}" >"$_rt"
  if diff -q "$_rt" "$TEMPLATE_FILE" >/dev/null 2>&1; then
    echo "  [OK]   $SYSTEMD_TEMPLATE matches this version's template"
    rm -f "$_rt"; return 0
  fi
  echo "  [FAIL] $SYSTEMD_TEMPLATE DIFFERS from this version's"\
       "template (hand-edited, or stale); run '${APP_NAME} install'"
  rm -f "$_rt"; return 1
}

# The singleton this replaced. If it survives it drives the SAME mountpoint
# under a second unit name, so two managers fight over one tree and whichever
# stops last unmounts a tree the other still believes it owns.
check_legacy_singleton() {
  systemctl --user list-unit-files 2>/dev/null | grep -q "^$LEGACY_UNIT" \
    || return 0
  echo "  [FAIL] the retired singleton $LEGACY_UNIT is still installed;"\
       "run '${APP_NAME} install' to sweep it"
  return 1
}

# EVERY rclone-backed source must have a live instance. The singleton could
# only ever be asked about one unit, so the interesting question -- is each
# configured remote actually mounted -- could not even be posed.
check_source_instances() {
  _r=0; _any=
  for _s in $(rclone_sources); do
    _any=y
    _u=$(mount_unit "$_s")
    if systemctl --user is-enabled "$_u" >/dev/null 2>&1; then
      echo "  [OK]   $_u enabled"
    else
      echo "  [FAIL] $_u not enabled (source '$_s' will not mount at boot)"
      _r=1
    fi
    if systemctl --user is-active "$_u" >/dev/null 2>&1; then
      echo "  [OK]   $_u active"
    else
      echo "  [FAIL] $_u not active (source '$_s' is NOT mounted)"; _r=1
    fi
  done
  [ -n "$_any" ] || echo "  [OK]   no rclone-backed source; nothing to mount"
  return $_r
}

# An instance enabled for a source that no longer exists never starts, and says
# nothing about why. Catch the orphan rather than let it rot.
check_orphan_instances() {
  _r=0
  for _in in $(enabled_instances); do
    rclone_sources | grep -qx "$_in" && continue
    echo "  [FAIL] $(mount_unit "$_in") is enabled but '$_in' is not an"\
         "rclone-backed source; it can never mount"
    _r=1
  done
  return $_r
}

do_check() {
  echo "== charon-mount unit check =="
  _r=0
  # NO rclone-backed source means charon mounts nothing, and install
  # DELIBERATELY writes no template in that case. Demanding one here made a
  # BYO-only install (every source PROVIDER=none) fail check FOREVER: install
  # exits 0, check exits 1, with nothing a user could do about it. PROVIDER=none
  # is an advertised feature, and an integrator that delegates its verdict to
  # `charon check` -- which is the contract -- would have shown permanent drift.
  #
  # A stale template or instance is STILL drift here, because it can only have
  # come from a source that has since gone away, so those two checks still run.
  if [ -z "$(rclone_sources)" ]; then
    echo "  [OK]   no rclone-backed source; charon mounts nothing here"
    check_legacy_singleton || _r=1
    check_orphan_instances || _r=1
    return $_r
  fi
  if [ ! -f "$TEMPLATE_FILE" ]; then
    echo "  [FAIL] $SYSTEMD_TEMPLATE missing (run '${APP_NAME} install')"
    return 1
  fi
  # All four run; none short-circuits, so one failure never hides the next.
  check_mount_template   || _r=1
  check_legacy_singleton || _r=1
  check_source_instances || _r=1
  check_orphan_instances || _r=1
  return $_r
}

do_install() {
  # No blanket tty guard: install is non-interactive when the rclone remote is
  # already configured (restored, or pulled from a peer), the common case. The
  # ONE interactive step, a first-machine `rclone config`, is gated on stdin
  # inside ensure_rclone, which fails loud with guidance when needed but no
  # terminal is present.
  # Privilege is needed for ONE thing: apt-installing rclone when it is absent
  # (ensure_rclone does that itself, and asks for sudo there). Demanding it up
  # front made `charon mount install` unrunnable from any non-TTY context on a
  # box that needed no privilege at all, which is the same false prerequisite
  # that turned every routine regeneration into a sudo handoff.
  ensure_rclone

  mkdir -p "$_sd"
  render_unit "$CHARON_REMOTE" >"$TEMPLATE_FILE"
  log_info "installed systemd template: $TEMPLATE_FILE"

  command -v systemctl >/dev/null 2>&1 || {
    log_warn "systemctl not found: $SYSTEMD_TEMPLATE is WRITTEN but NOTHING"\
             "IS SCHEDULED; the mount will not come up on its own."
    return 0
  }
  sweep_legacy_singleton
  systemctl --user daemon-reload

  _u=$(mount_unit "$CHARON_SOURCE")
  systemctl --user enable --now "$_u" || {
    log_error "failed to enable/start $_u"
    exit 1
  }
  log_info "$_u enabled and started for ${REMOTE_NAME}: at $MOUNTPOINT"
}

# Retire the pre-template singleton. Idempotent, and deliberately BEFORE the
# instance starts: both units drive the SAME mountpoint, so leaving the old one
# enabled means two managers fighting over one tree, and whichever stops last
# unmounts a tree the other still thinks it owns.
sweep_legacy_singleton() {
  [ -f "$_sd/$LEGACY_UNIT" ] \
    || systemctl --user list-unit-files 2>/dev/null \
         | grep -q "^$LEGACY_UNIT" \
    || return 0
  log_info "sweeping the retired singleton $LEGACY_UNIT"
  systemctl --user disable --now "$LEGACY_UNIT" >/dev/null 2>&1 || :
  rm -f "$_sd/$LEGACY_UNIT"
  return 0
}

# ---- main dispatch ----

do_uninstall() {
  # The units only. The mountpoints and everything under them are the user's.
  # EVERY instance, not just this shell's source: uninstall that left another
  # remote's unit enabled would leave a unit pointing at a template it just
  # deleted, which systemd reports as a load failure on every daemon-reload.
  for _in in $(enabled_instances); do
    systemctl --user disable --now "$(mount_unit "$_in")" >/dev/null 2>&1 || :
  done
  sweep_legacy_singleton
  rm -f "$TEMPLATE_FILE"
  systemctl --user daemon-reload >/dev/null 2>&1 || :
  log_info "removed the charon-mount units; the mountpoints are untouched"
}

# SOURCEABLE FOR TESTING. Every test until now drove the whole command against
# stubs, which is slow and cannot reach an edge case cheaply. With this, a unit
# test sources the file and calls a function directly with controlled input.
# Executing the script is unaffected: the variable is only ever set by a test.
# shellcheck disable=SC2317  # the dispatch below IS reached when executed
# UNSET IT BEFORE RETURNING. The flag has to be visible to the shell that is
# sourcing this file, but if it survives into the ENVIRONMENT every sibling impl
# a function shells out to (charon-source health / status / seed / probe) hits
# this same guard and exits 0 having done NOTHING -- a silent no-op that reads
# as success. Measured: seed_profile "succeeded" without running rclone at all,
# and a gate "passed" because charon-source status no-op'd. Unsetting here makes
# the seam safe no matter how a test sets the variable.
if [ -n "${CHARON_LIB_ONLY:-}" ]; then
  unset CHARON_LIB_ONLY
  return 0 2>/dev/null || exit 0
fi

case "$1" in
  run)     shift; do_mount "$@" ;;
  stop)    do_unmount ;;
  status)  do_status ;;
  install)   do_install ;;
  uninstall) do_uninstall ;;
  check)     do_check; exit $? ;;
  ""|help|-h|--help) usage ;;
  *)
    log_error "unknown command: $1"
    usage
    exit 1
    ;;
esac

# The blocks below are DATA, not code: unit and profile templates read back out
# of this file. They still have to parse as shell (dash -n reads past exit 0,
# which is why a bare "(" in a unit Description once broke the build), but
# shellcheck cannot know that and reports them as broken test expressions.
# shellcheck disable=SC1035,SC1072,SC1073,SC1020,SC1007,SC2317
exit 0

#-----BEGIN-SYSTEMD-UNIT-CHARON-MOUNT-----
[Unit]
Description=charon FUSE mount for source %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %i IS the source, so NOTHING source-specific is baked here: charon resolves
# the remote and the mountpoint from sources.d at run time and one template
# serves every instance. CHARON_REMOTE below is the fallback the IMPLICIT
# 'default' source derives from, and is ignored by any declared source.
Environment=CHARON_REMOTE=@CHARON_REMOTE@
Environment=RCLONE_CONFIG=%h/.config/rclone/rclone.conf
ExecStart=%h/.local/bin/charon source up %i
ExecStop=%h/.local/bin/charon source down %i
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
#-----END-SYSTEMD-UNIT-CHARON-MOUNT-----
